# Local development. Copy to .env, then run `npm run dev`.

# mock = deterministic stub, no model call (demo/tests) | gemini = Google Gemini | none = rules only
AI_PROVIDER=mock

# Local database: sqlite (default, DATA_DIR/aarogya.db) | local (JSON files) | gcp (Firestore + Cloud Storage)
# STORE=sqlite

# For AI_PROVIDER=gemini with the Gemini Developer API: create a key in Google AI Studio (aistudio.google.com).
# GEMINI_API_KEY=
# Comma-separated fallbacks: the next model is tried if one is overloaded (503) or rate-limited (429).
GEMINI_MODEL=gemini-3.8-flash,gemini-3-flash-preview,gemini-flash-latest,gemini-3.1-flash-lite

# Or use Vertex AI (Gemini Enterprise Agent Platform) with your gcloud credentials instead of a key:
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-south1

PORT=8080
DATA_DIR=.localdata

# Optional: keeps sign-ins valid across dev-server restarts. Any long random string.
# SESSION_SECRET=
