# Local development. Copy to .env, then run `npm run dev`.

# mock = deterministic stub, no model call (demo/tests) | gemini = Google Gemini | none = rules only
AI_PROVIDER=mock

# For AI_PROVIDER=gemini with the Gemini Developer API: create a key in Google AI Studio (aistudio.google.com).
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Or use Vertex AI (Gemini Enterprise Agent Platform) with your gcloud credentials instead of a key:
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-south1

PORT=8080
DATA_DIR=.localdata
