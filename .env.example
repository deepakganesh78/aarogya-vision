# Local development. Copy to .env, then run `npm run dev`.

# mock = deterministic stub, no model call (demo/tests) | gemini = Google Gemini | none = rules only
AI_PROVIDER=mock

# Local database: sqlite (default, DATA_DIR/aarogya.db) | local (JSON files) | gcp (Firestore + Cloud Storage)
# STORE=sqlite

# For AI_PROVIDER=gemini with the Gemini Developer API: create a key in Google AI Studio (aistudio.google.com).
# GEMINI_API_KEY=
# Comma-separated fallbacks: the next model is tried if one is overloaded (503) or rate-limited (429).
GEMINI_MODEL=gemini-3.8-flash,gemini-3-flash-preview,gemini-flash-latest,gemini-3.1-flash-lite

# Or use Vertex AI (Gemini Enterprise Agent Platform) with your gcloud credentials instead of a key:
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=asia-south1
# On Vertex AI in asia-south1 use GEMINI_MODEL=gemini-3.5-flash (gemini-3.8-flash is served only from "global").

# Optional: Gemini Live API for live text and spoken follow-up questions while the worker records.
# SPEECH_PROVIDER=gemini-live
# LIVE_MODEL=gemini-3.8-live
# LIVE_LOCATION=asia-south1

# Optional Google Cloud services (production defaults come from scripts/deploy-cloudrun.sh):
# PUBSUB_TOPIC=aarogya-case-events          # Cloud Pub/Sub: urgent alerts + cross-instance live updates
# FHIR_STORE=aarogya-fhir                    # Cloud Healthcare API FHIR R4 store (else DATA_DIR/fhir)
# HEALTHCARE_DATASET=aarogya
# HEALTHCARE_LOCATION=asia-south1
# RAG_CORPUS=projects/<project>/locations/asia-south1/ragCorpora/<id>   # Vertex AI RAG Engine (guideline PDFs)

# Optional: on-phone Gemma danger-sign helper (Google AI Edge MediaPipe LLM Inference, WebGPU).
# A Gemma 3 1B IT int4 web model (.task) that you host yourself; never committed. Either a same-origin
# path (put the file in public/models/, which is gitignored) or a public https URL with CORS for this app
# (for example a public-read Cloud Storage object). Unset = the helper is hidden.
# GEMMA_MODEL_URL=/models/gemma3-1b-it-int4-web.task
# GEMMA_MODEL_URL=https://storage.googleapis.com/your-bucket/gemma3-1b-it-int4-web.task

# Demo auto sign-in: the ASHA app and the doctor dashboard open signed in, no access code.
# Default: on outside production, off in production unless set to true (synthetic-data demos only).
# AUTO_LOGIN=false

PORT=8080
DATA_DIR=.localdata

# Optional: keeps sign-ins valid across dev-server restarts. Any long random string.
# SESSION_SECRET=
